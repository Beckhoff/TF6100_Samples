		<DataType>
			<Name GUID="{F2E23DFE-0EF0-465E-B7E5-80E81FA4AB06}" TcBaseType="true">OpcUaDeviceStatus</Name>
			<BitSize>16</BitSize>
			<SubItem>
				<Name>Connected</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000010}">BIT</Type>
				<Comment><![CDATA[connection status
1 = TRUE | 0 = FALSE]]></Comment>
				<BitSize>1</BitSize>
				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>ReadBusy</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000010}">BIT</Type>
				<Comment><![CDATA[only active in triggered mode
1 = TRUE | 0 = FALSE]]></Comment>
				<BitSize>1</BitSize>
				<BitOffs>1</BitOffs>
			</SubItem>
			<SubItem>
				<Name>KeepAlives</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000013}">BIT4</Type>
				<Comment><![CDATA[number of remaining keepalive messages until reset
only active in subscription mode]]></Comment>
				<BitSize>4</BitSize>
				<BitOffs>4</BitOffs>
			</SubItem>
			<SubItem>
				<Name>StmState</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000001}">BYTE</Type>
				<Comment><![CDATA[client statemachine states:
 0 = Init				|  6 = Read DataType Descriptions	| 12 = Running
 1 = Connect			|  7 = Disconnect			| 13 = Disconnecting
 2 = Read Namespace Table		|  8 = Reset			| 14 = Browse NodeIds
 3 = Update Namespace Information	|  9 = StartUp			| 15 = Error
 4 = Read DataTypes		| 10 = Create Subscriptions		| 16 = Idle
 5 = Read Method Arguments		| 11 = Create MonitoredItems		| 17 = Shutdown]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>8</BitOffs>
			</SubItem>
		</DataType>
		<DataType>
			<Name GUID="{7CD7A8B9-2459-4D9A-A7D6-EA64744B3C97}" TcBaseType="true">OpcUaDeviceControl</Name>
			<BitSize>16</BitSize>
			<SubItem>
				<Name>ResetStm</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000010}">BIT</Type>
				<Comment><![CDATA[resetting client by setting bit true]]></Comment>
				<BitSize>1</BitSize>
				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>Execute</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000010}">BIT</Type>
				<Comment><![CDATA[in triggered mode set bit true to execute a read/write operation]]></Comment>
				<BitSize>1</BitSize>
				<BitOffs>1</BitOffs>
			</SubItem>
			<SubItem>
				<Name>Write Enable</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000010}">BIT</Type>
				<Comment><![CDATA[enable client wide write operations by setting bit to true]]></Comment>
				<BitSize>1</BitSize>
				<BitOffs>2</BitOffs>
			</SubItem>
		</DataType>
	</DataTypes>
