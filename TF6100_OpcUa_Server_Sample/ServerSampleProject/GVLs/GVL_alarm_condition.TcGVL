<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_alarm_condition" Id="{9b3816fd-8668-4c5f-906d-fb4d9b43c8d0}">
    <Declaration><![CDATA[VAR_GLOBAL
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Description' := 'Triggers a LimitAlarmType when value reaches 10 or 0. Increments every 10 secs'}
	limitAlmTrigger: DINT;
	
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Description' := 'Triggers an OffNormalAlarmType when set to true. State changes state every 10 secs.'}
	offNormAlmTrigger : BOOL;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>